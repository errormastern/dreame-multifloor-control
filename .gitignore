# ============================================================================
# WHITELIST APPROACH - Maximum Security
# ============================================================================
# By default, EVERYTHING is ignored. Only explicitly allowed files are public.
# This prevents accidental commits of private development files.

# .gitignore itself is NOT public
.gitignore

# ============================================================================
# DEFAULT: IGNORE EVERYTHING
# ============================================================================
*
*/

# ============================================================================
# PUBLIC FILES (Explicitly Allowed)
# ============================================================================

# Main blueprint file
!vacuum_control.yaml

# Public documentation
!README.md
!CONFIGURATION.md

# Future: Documentation images (uncomment when needed)
# !images/
# !images/**/*.png
# !images/**/*.jpg
# !images/**/*.gif

# ============================================================================
# SYSTEM FILES (Always Ignored, Even if Whitelisted)
# ============================================================================
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*

# macOS metadata
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# IDE directories
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================================================
# PRIVATE FILES (Automatically Ignored by Blacklist)
# ============================================================================
# These are automatically ignored by the "*" rule above, but listed here
# for documentation purposes:
#
# - CLAUDE.md                  (Project instructions for Claude Code)
# - BACKLOG.md                 (Development backlog)
# - DEVELOPMENT_NOTES.md       (Technical notes)
# - CHANGELOG_*.md             (Version changelogs)
# - _blueprint_reference/      (Internal documentation)
# - input/                     (Reference documentation)
# - examples/                  (Blueprint examples)
# - PROJECT_PLAN.md            (Project planning)
# - TEST_STRATEGY.md           (Testing documentation)
# - All other .md files        (Development documentation)
# ============================================================================
